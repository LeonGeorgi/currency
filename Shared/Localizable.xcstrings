    "Zuletzt geladene Kurse und Zeitreihen bleiben auf diesem Gerät gespeichert. Schlägt eine Aktualisierung fehl, werden gespeicherte Daten entsprechend gekennzeichnet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt geladene Kurse und Zeitreihen bleiben auf diesem Gerät gespeichert. Schlägt eine Aktualisierung fehl, werden gespeicherte Daten entsprechend gekennzeichnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previously loaded rates and history stay saved on this device. If a refresh fails, saved data is labeled accordingly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み済みのレートと履歴は、このデバイスに保存されます。更新に失敗した場合は、保存済みのデータであることが表示されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los últimos tipos e historiales cargados se guardan en este dispositivo. Si una actualización falla, los datos guardados se indican como tales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les derniers cours et historiques chargés restent enregistrés sur cet appareil. Si une actualisation échoue, les données enregistrées sont signalées comme telles."
          }
        }
      }
    },
    "Zum Laden App öffnen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Laden App öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open app to load rates"
          }
        },
        "ja": {
