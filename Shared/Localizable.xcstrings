    "Die Kurse dienen der Orientierung. Tatsächliche Umrechnungskurse können durch Gebühren und Aufschläge abweichen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurse dienen der Orientierung. Tatsächliche Umrechnungskurse können durch Gebühren und Aufschläge abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rates are for reference. Actual exchange rates may differ due to fees and markups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レートは参考値です。実際の換算レートは、手数料や上乗せ額によって異なる場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos tipos son orientativos. Los tipos aplicados pueden variar debido a comisiones y recargos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces cours sont donnés à titre indicatif. Les taux réellement appliqués peuvent varier en raison de frais et de marges."
          }
        }
      }
    },
