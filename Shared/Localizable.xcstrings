            "state": "translated",
            "value": "Toca + para añadir una moneda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour ajouter une devise."
          }
        }
      }
    },
    "Für diesen Kurs gibt es gerade keine einfache Faustregel.": {
      "extractionState": "manual",
      "localizations": {
