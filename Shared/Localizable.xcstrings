    "Frankfurter ist gerade nicht erreichbar. Bitte versuche es später erneut.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter ist gerade nicht erreichbar. Bitte versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter is currently unavailable. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在Frankfurterに接続できません。しばらくしてからもう一度お試しください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter no está disponible en este momento. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter est momentanément indisponible. Veuillez réessayer plus tard."
          }
        }
      }
    },
    "Frankfurter stellt tägliche Referenzkurse aus offiziellen Quellen bereit. An Wochenenden und Feiertagen kann der zuletzt veröffentlichte Kurs angezeigt werden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter stellt tägliche Referenzkurse aus offiziellen Quellen bereit. An Wochenenden und Feiertagen kann der zuletzt veröffentlichte Kurs angezeigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter provides daily reference rates from official sources. On weekends and holidays, the latest published rate may be shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurterは、公的な情報源に基づく日次の参考為替レートを提供しています。週末や祝日は、直近に公表されたレートが表示される場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter ofrece tipos de cambio de referencia diarios de fuentes oficiales. Los fines de semana y festivos puede mostrarse el último tipo publicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frankfurter fournit des cours de référence quotidiens provenant de sources officielles. Le week-end et les jours fériés, le dernier cours publié peut être affiché."
          }
        }
      }
    },
    "Füge über das Plus eine Währung hinzu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge über das Plus eine Währung hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + to add a currency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋をタップして通貨を追加できます。"
          }
        },
        "es": {
