            "state": "translated",
            "value": "Abre la app para cargar los tipos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app pour charger les cours"
          }
        }
      }
    },
    "Öffne die App, um den Betrag zu korrigieren.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App, um den Betrag zu korrigieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app to correct the amount."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いて金額を修正してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app para corregir el importe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app pour corriger le montant."
          }
        }
      }
    },
    "Über Bearbeiten kannst du die Vergleichswährungen verschieben und löschen. Ihre Reihenfolge bestimmt die Anzeige im Widget. Tippe auf das Widget, um die App zu öffnen. iOS bestimmt den genauen Zeitpunkt der Aktualisierung.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Bearbeiten kannst du die Vergleichswährungen verschieben und löschen. Ihre Reihenfolge bestimmt die Anzeige im Widget. Tippe auf das Widget, um die App zu öffnen. iOS bestimmt den genauen Zeitpunkt der Aktualisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Edit to reorder or delete comparison currencies. Their order determines what the widget shows. Tap the widget to open the app. iOS decides exactly when the widget refreshes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「編集」から換算先の並べ替えや削除ができます。この順序がウィジェットの表示に反映されます。ウィジェットをタップするとアプリが開きます。更新のタイミングはiOSによって決まります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Editar para reordenar o eliminar monedas de comparación. Su orden determina lo que muestra el widget. Toca el widget para abrir la app. iOS decide el momento exacto de la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Modifier pour réorganiser ou supprimer les devises de comparaison. Leur ordre détermine l’affichage du widget. Touchez le widget pour ouvrir l’app. iOS détermine le moment exact de l’actualisation."
          }
        }
      }
    },
